{
  "ActIndex": {
    "ModelPath": "models/all-MiniLM-L6-v2.onnx",
    "CorpusPath": "data/dpa_articles.json",
    "IndexPath": "data/section_index.json"
  },
  "VectorStore": {
    "Host": "127.0.0.1",
    "Port": 6334,
    "Collection": "dpa_sections_minilm",
    "KeyEnv": "QDRANT_API_KEY"
  },
  "Llm": {
    "MaxTokens": 1200,
    "TimeoutSeconds": 90,
    "Temperature": 0.1,
    "Providers": [
      {
        "Name": "groq",
        "BaseUrl": "https://api.groq.com/openai/v1",
        "KeyEnv": "GROQ_API_KEY",
        "Models": [
          "qwen/qwen3.8-27b",
          "openai/gpt-oss-120b"
        ],
        "KeyOptional": true
      },
      {
        "Name": "nvidia",
        "BaseUrl": "https://integrate.api.nvidia.com/v1",
        "KeyEnv": "DPA_RAG_LLM_KEY,NVIDIA_API_KEY",
        "Models": [
          "z-ai/glm-5.3-flash"
        ],
        "KeyOptional": true
      },
      {
        "Name": "ollama",
        "BaseUrl": "http://127.0.0.1:11434/v1",
        "KeyEnv": "OLLAMA_API_KEY",
        "Models": [
          "qwen2.5:7b"
        ],
        "KeyOptional": true
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
